Algoritmo MayorOMenor
	Definir Num1, Num2 Como Real
	
	Escribir "Esrte programa le ayudara a compara los valos y saber cual es mayor o si son iguales"
	
	Escribir "Ingrese el primer valor: "
	Leer Num1
	Escribir "Ingrese el segundo valor: "
	Leer Num2
	
	Si Num1 > Num2 Entonces
		Escribir "El Valor: ", Num1, " es mayor"
	SiNo
		Escribir "El Valor: ", Num2, " es mayor"
		si Num1 = Num2 Entonces
			Escribir "Los valores son iguales"
		FinSi
	FinSi
FinAlgoritmo
