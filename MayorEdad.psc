Algoritmo MayorEdad
	
	Definir edad Como Entero
	Escribir "Este programa sirve para saber si la persona es mayor de edad o no"
	Escribir "Ingrese su edad"
	Leer edad
	
	si edad >= 18 Entonces
		Escribir "Si puede votar"
		Escribir Verdadero
	SiNo
		Escribir "No puede votar"
		Escribir Falso
	FinSi
	
FinAlgoritmo
