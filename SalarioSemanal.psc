Algoritmo SalarioSemanal
	Definir DiasTrabajados, SalarioTotal Como Real
	
	Escribir "Este programa ayuda a calcular el salario semanala"
	Escribir "Ingrese el total de dias trabajados a la semana"
	Leer DiasTrabajados
	
	SalarioTotal = DiasTrabajados * 100
	
	Escribir "El salario total a la semana es: $", SalarioTotal
	
FinAlgoritmo
